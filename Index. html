
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chandru R | CSE Portfolio</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

:root {
  --bg: #0b1120;
  --card: #111c30;
  --text: #eaf1ff;
  --muted: #9baac3;
  --accent: #63e6be;
  --blue: #60a5fa;
}

body {
  font-family: 'Segoe UI', Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.7;
}

a {
  color: inherit;
  text-decoration: none;
}

.container {
  width: 90%;
  max-width: 1050px;
  margin: auto;
}

nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(11,17,32,0.95);
  border-bottom: 1px solid #243149;
  backdrop-filter: blur(10px);
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 0;
}

.logo {
  font-size: 22px;
  font-weight: bold;
  color: var(--accent);
}

.nav-links {
  display: flex;
  gap: 22px;
  font-size: 14px;
  color: var(--muted);
}

.nav-links a:hover {
  color: var(--accent);
}

.hero {
  min-height: 85vh;
  display: flex;
  align-items: center;
  padding: 60px 0;
}

.hero-content {
  max-width: 750px;
}

.tagline {
  color: var(--accent);
  font-size: 15px;
  letter-spacing: 2px;
  margin-bottom: 15px;
}

.hero h1 {
  font-size: clamp(38px, 7vw, 72px);
  line-height: 1.15;
  margin-bottom: 20px;
}

.hero h1 span {
  color: var(--accent);
}

.hero p {
  color: var(--muted);
  font-size: 17px;
  max-width: 650px;
  margin-bottom: 28px;
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.btn {
  display: inline-block;
  padding: 12px 22px;
  border-radius: 8px;
  font-weight: 600;
  border: 1px solid var(--accent);
  transition: 0.3s;
}

.btn-primary {
  background: var(--accent);
  color: #08131a;
}

.btn-outline {
  color: var(--accent);
}

.btn:hover {
  transform: translateY(-3px);
  opacity: 0.85;
}

section {
  padding: 75px 0;
}

.section-title {
  font-size: 32px;
  margin-bottom: 12px;
}

.section-title span {
  color: var(--accent);
}

.section-subtitle {
  color: var(--muted);
  margin-bottom: 35px;
}

.about-box {
  background: var(--card);
  border: 1px solid #263650;
  padding: 28px;
  border-radius: 16px;
}

.about-box p {
  color: var(--muted);
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  margin-top: 25px;
}

.info-item {
  background: #17243a;
  padding: 16px;
  border-radius: 10px;
}

.info-item small {
  color: var(--accent);
  display: block;
  margin-bottom: 5px;
}

.info-item strong {
  font-size: 15px;
}

.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 16px;
}

.skill {
  background: var(--card);
  border: 1px solid #263650;
  border-radius: 12px;
  padding: 22px 15px;
  text-align: center;
  transition: 0.3s;
}

.skill:hover {
  border-color: var(--accent);
  transform: translateY(-5px);
}

.skill .symbol {
  font-size: 28px;
  color: var(--accent);
  margin-bottom: 8px;
}

.skill h3 {
  font-size: 16px;
}

.project-card {
  background: var(--card);
  border: 1px solid #263650;
  border-radius: 16px;
  overflow: hidden;
  transition: 0.3s;
}

.project-card:hover {
  transform: translateY(-5px);
  border-color: var(--accent);
}

.project-top {
  background: linear-gradient(135deg, #17324d, #164e63);
  padding: 35px;
  text-align: center;
}

.project-top .project-icon {
  font-size: 48px;
}

.project-body {
  padding: 25px;
}

.project-body h3 {
  font-size: 23px;
  margin-bottom: 12px;
}

.project-body p {
  color: var(--muted);
  margin-bottom: 18px;
}

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 20px;
}

.project-tags span {
  background: #20324d;
  color: var(--accent);
  padding: 5px 12px;
  border-radius: 20px;
  font-size: 12px;
}

.cert-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

.cert-card {
  background: var(--card);
  border: 1px solid #263650;
  padding: 24px;
  border-radius: 12px;
}

.cert-card h3 {
  margin-bottom: 8px;
}

.cert-card p {
  color: var(--muted);
  font-size: 14px;
}

.contact-box {
  background: linear-gradient(135deg, #14243a, #102d3d);
  border: 1px solid #2d5360;
  padding: 35px;
  border-radius: 16px;
  text-align: center;
}

.contact-box p {
  color: var(--muted);
  margin: 15px 0 25px;
}

.contact-links {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 14px;
}

footer {
  border-top: 1px solid #243149;
  padding: 25px 0;
  text-align: center;
  color: var(--muted);
  font-size: 13px;
}

footer span {
  color: var(--accent);
}

@media (max-width: 600px) {
  .nav-links {
    gap: 12px;
    font-size: 12px;
  }

  .hero {
    min-height: 75vh;
  }

  .info-grid {
    grid-template-columns: 1fr;
  }

  section {
    padding: 55px 0;
  }

  .section-title {
    font-size: 27px;
  }

  .project-top {
    padding: 25px;
  }
}
</style>
</head>

